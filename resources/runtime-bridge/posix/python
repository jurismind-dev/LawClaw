#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
RESOURCES_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
VENV_DIR="$HOME/.LawClaw/support/managed-python/3.12/$(uname | tr '[:upper:]' '[:lower:]')"
VENV_PYTHON_EXE="$VENV_DIR/bin/python"
READY_MARKER="$VENV_DIR/.lawclaw-managed-python-ready.json"
PYTHON_CHECK_SCRIPT='import importlib
modules = ["docx", "openpyxl", "lxml", "defusedxml"]
missing = []
for name in modules:
    try:
        importlib.import_module(name)
    except Exception as exc:
        missing.append(f"{name}: {exc}")
if missing:
    print("\n".join(missing))
    raise SystemExit(1)
'

if [ -n "${LAWCLAW_BUNDLED_UV_EXE:-}" ] && [ -x "${LAWCLAW_BUNDLED_UV_EXE}" ]; then
  UV_EXE="${LAWCLAW_BUNDLED_UV_EXE}"
else
  UV_EXE="$RESOURCES_DIR/bin/uv"
fi

if [ ! -x "$UV_EXE" ]; then
  echo "Bundled uv runtime not found: $UV_EXE" >&2
  exit 1
fi

if [ -x "$VENV_PYTHON_EXE" ] && [ -f "$READY_MARKER" ]; then
  exec "$VENV_PYTHON_EXE" "$@"
fi

if [ -x "$VENV_PYTHON_EXE" ] && "$VENV_PYTHON_EXE" -c "$PYTHON_CHECK_SCRIPT" >/dev/null 2>&1; then
  if [ ! -f "$READY_MARKER" ]; then
    printf '{"version":"3.12"}\n' >"$READY_MARKER" 2>/dev/null || true
  fi
  exec "$VENV_PYTHON_EXE" "$@"
fi

BASE_PYTHON_EXE="$("$UV_EXE" python find 3.12 --managed-python 2>/dev/null || true)"
if [ -z "$BASE_PYTHON_EXE" ]; then
  "$UV_EXE" python install 3.12
  BASE_PYTHON_EXE="$("$UV_EXE" python find 3.12 --managed-python 2>/dev/null || true)"
fi

if [ -z "$BASE_PYTHON_EXE" ] || [ ! -x "$BASE_PYTHON_EXE" ]; then
  echo "Managed Python 3.12 is not available through bundled uv." >&2
  exit 1
fi

if [ ! -x "$VENV_PYTHON_EXE" ]; then
  "$UV_EXE" venv --no-project --clear --python "$BASE_PYTHON_EXE" "$VENV_DIR"
fi

if [ ! -x "$VENV_PYTHON_EXE" ]; then
  echo "Managed Python venv is not available: $VENV_PYTHON_EXE" >&2
  exit 1
fi

if ! "$VENV_PYTHON_EXE" -c "$PYTHON_CHECK_SCRIPT" >/dev/null 2>&1; then
  "$UV_EXE" pip install --python "$VENV_PYTHON_EXE" --strict python-docx openpyxl lxml defusedxml
  "$VENV_PYTHON_EXE" -c "$PYTHON_CHECK_SCRIPT"
fi

printf '{"version":"3.12"}\n' >"$READY_MARKER" 2>/dev/null || true
exec "$VENV_PYTHON_EXE" "$@"
